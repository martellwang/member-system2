APP_NAME=會員管理系統
APP_URL=https://www.newpay.com.tw/member
APP_ENV=production
APP_TIMEZONE=Asia/Taipei

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=newpay_member
DB_USERNAME=newpay_member_user
DB_PASSWORD=replace-with-secret

ADMIN_EMAIL=admin@system.com
ADMIN_PASSWORD=replace-with-strong-secret
ADMIN_SESSION_TIMEOUT_SECONDS=1800
MEMBER_SESSION_TIMEOUT_SECONDS=600

MAIL_FROM=no-reply@newpay.com.tw
MAIL_FROM_NAME=NewPay
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-secret
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=www.newpay.com.tw
MAIL_VERIFY_PEER=true

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
